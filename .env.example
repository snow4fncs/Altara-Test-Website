# Unlocks /admin-reviews.html so you can publish submitted reviews.
# Any long random string. If this is not set, the moderation endpoint stays
# closed and nothing can be published in production.
ADMIN_TOKEN=
# Meta Conversions API - sends Purchase server-side from api/webhook.js.
# Events Manager > your pixel > Settings > Conversions API > Generate access token.
# Without this token, purchases are NOT reported to Meta at all.
META_CAPI_TOKEN=
# Optional. Defaults to the pixel already in the pages (1907598646567033).
META_PIXEL_ID=
# Optional. Paste a code from Events Manager > Test Events to verify the setup,
# then REMOVE it - events sent with a test code do not count as real conversions.
META_TEST_EVENT_CODE=
